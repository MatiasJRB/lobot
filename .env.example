# =============================================================================
# Clawbot Personal — OpenClaw on Railway
# =============================================================================
# Copy to .env only for local testing. In Railway, set these as service Variables.
# Never commit real secrets.
# =============================================================================

# ----------------------------------------------------------------------------
# Required for Railway/OpenClaw
# ----------------------------------------------------------------------------

# Password for the /setup wizard. Generate a strong one.
SETUP_PASSWORD=replace-with-strong-setup-password

# Admin token for OpenClaw Gateway / Control UI. Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=replace-with-hex-token

# Railway public HTTP port. Keep 8080 to match Railway HTTP Proxy and docs.
PORT=8080
OPENCLAW_GATEWAY_PORT=8080

# Persistent Railway Volume paths. Mount a Railway volume at /data.
OPENCLAW_STATE_DIR=/data/.openclaw
OPENCLAW_WORKSPACE_DIR=/data/workspace

# Internal gateway port used behind this setup wrapper.
INTERNAL_GATEWAY_HOST=127.0.0.1
INTERNAL_GATEWAY_PORT=18789

# Pin an OpenClaw version only if needed. "latest" follows upstream releases.
OPENCLAW_VERSION=latest
OPENCLAW_ENTRY=/usr/local/lib/node_modules/openclaw/dist/entry.js
OPENCLAW_NODE=node

# ----------------------------------------------------------------------------
# Gemini — primary model provider for the personal assistant
# ----------------------------------------------------------------------------

# Set this in Railway from the local secret file, not here.
# Local secret file created on this machine:
# /Users/matiasrios/Documents/GitHub/personal-assistant-secrets/gemini-api-key-details.txt
GEMINI_API_KEY=replace-in-railway-only

# OpenClaw model ref. If this exact model is not available in the installed catalog,
# the setup logs will show a models-set failure and OpenClaw can keep its default.
GEMINI_MODEL=google/gemini-3.1-flash-lite
# Alias used by the wrapper; either variable works.
OPENCLAW_DEFAULT_MODEL=${GEMINI_MODEL}

# ----------------------------------------------------------------------------
# Discord — notification channel
# ----------------------------------------------------------------------------

# Create a fresh Discord app/bot token and store it in Railway Variables.
DISCORD_BOT_TOKEN=replace-in-railway-only

# Application/client ID from the Discord Developer Portal. Setting it lets
# OpenClaw skip Discord startup lookup calls that can be rate-limited.
DISCORD_APPLICATION_ID=

# Optional but recommended: restrict the bot to your private personal server/channel.
# Values are numeric Discord IDs. Enable Developer Mode in Discord to copy IDs.
DISCORD_GUILD_ID=
DISCORD_PERSONAL_CHANNEL_ID=
DISCORD_OWNER_USER_ID=

# Where cron digests should be delivered. Use one of:
#   channel:<discord-channel-id>
#   user:<discord-user-id>
DISCORD_PERSONAL_CHANNEL_TARGET=channel:replace-with-channel-id

# In a private assistant channel, false lets you talk naturally without @mention.
DISCORD_REQUIRE_MENTION=false

# ----------------------------------------------------------------------------
# Optional future connectors / credentials
# ----------------------------------------------------------------------------

# GitHub personal token for MatiasJRB.
# MVP collector reads notifications, searches open assigned/mentioned/review-requested
# items, and checks recent failed Actions runs in repos owned by GITHUB_OWNER_ALLOWLIST.
# Fine-grained token recommendation: read-only Metadata + Notifications + Issues/Pull
# requests + Actions for the personal repos you want monitored.
GITHUB_TOKEN=
GITHUB_USERNAME=MatiasJRB
GITHUB_OWNER_ALLOWLIST=MatiasJRB
GITHUB_ENABLED=true
GITHUB_MAX_RESULTS=15
GITHUB_CHECK_WORKFLOW_RUNS=true
GITHUB_WORKFLOW_MAX_REPOS=8

# Google/Gmail/Calendar integration for matiasjriosb@gmail.com.
# Create an OAuth client, grant read-only scopes, then store the refresh token
# in Railway Variables. Do not commit real tokens.
# Scopes:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/calendar.readonly (or https://www.googleapis.com/auth/calendar.events for event create/update/delete)
GOOGLE_ACCOUNT_EMAIL=matiasjriosb@gmail.com

# Option A: one OAuth refresh token with both Gmail + Calendar scopes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Option B: separate existing tokens per service. Service-specific variables
# take precedence over the global GOOGLE_OAUTH_* variables.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_REFRESH_TOKEN=
# Set true only when Calendar OAuth includes https://www.googleapis.com/auth/calendar.events
CALENDAR_WRITE_ENABLED=false

# Alternative short-lived local test token. Not recommended for Railway.
GOOGLE_ACCESS_TOKEN=
GMAIL_ACCESS_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=

GMAIL_ENABLED=true
GMAIL_QUERY=in:inbox newer_than:7d -category:promotions -category:social -category:forums
GMAIL_MAX_RESULTS=20

GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_IDS=primary
GOOGLE_CALENDAR_MAX_RESULTS=30
CALENDAR_UPCOMING_SOON_MINUTES=120

# Personal digest collector / Discord output.
PERSONAL_TIMEZONE=America/Argentina/Buenos_Aires
PERSONAL_DIGEST_USE_GEMINI=true
# Defaults to GEMINI_MODEL with the "google/" prefix stripped when omitted.
PERSONAL_DIGEST_GEMINI_MODEL=
PERSONAL_DIGEST_MAX_SIGNALS=12
DISCORD_MESSAGE_MAX_CHARS=1900

# Command cron runtime limits.
PERSONAL_DIGEST_CRON_TIMEOUT_SECONDS=240
PERSONAL_DIGEST_CRON_NO_OUTPUT_TIMEOUT_SECONDS=90
PERSONAL_DIGEST_CRON_OUTPUT_MAX_BYTES=20000

# ----------------------------------------------------------------------------
# Optional setup wrapper features
# ----------------------------------------------------------------------------
ENABLE_WEB_TUI=false
TUI_IDLE_TIMEOUT_MS=300000
TUI_MAX_SESSION_MS=1800000
