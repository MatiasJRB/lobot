{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "executionOwner", "cases", "whatsapp"],
  "properties": {
    "version": {"const": 1},
    "executionOwner": {"const": "existing-worker"},
    "cases": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,79}$", "not": {"pattern": "[Mm][Aa][Nn][Gg][Oo]"}}},
    "whatsapp": {"type": "object", "additionalProperties": false, "required": ["accountId", "self"],
      "properties": {"accountId": {"const": "default"}, "self": {"type": "string", "pattern": "^\\+[1-9][0-9]{7,14}$"}}}
  }
}
