diff --git a/extensions/whatsapp/src/inbound/ingress-attestation.test.ts b/extensions/whatsapp/src/inbound/ingress-attestation.test.ts
new file mode 100644
index 0000000000..f4e9b2f642
--- /dev/null
+++ b/extensions/whatsapp/src/inbound/ingress-attestation.test.ts
@@ -0,0 +1,388 @@
+import { createHash, createHmac } from "node:crypto";
+import { mkdtemp, rm } from "node:fs/promises";
+import net from "node:net";
+import os from "node:os";
+import path from "node:path";
+import type { proto } from "baileys";
+import { afterEach, describe, expect, it } from "vitest";
+import {
+  attachWhatsAppIngressRawFacts,
+  attestWhatsAppInboundBeforeHooks,
+  buildWhatsAppIngressEnvelope,
+  canonicalWhatsAppIngressEnvelope,
+  captureWhatsAppIngressRawFacts,
+  copyWhatsAppIngressRawFacts,
+  deliverWhatsAppIngressAttestation,
+  resolveWhatsAppIngressRawFacts,
+  signWhatsAppIngressEnvelope,
+  whatsappIngressAttestationId,
+  type WhatsAppIngressCanonicalContext,
+  type WhatsAppIngressEnvelope,
+} from "./ingress-attestation.js";
+
+const temporaryDirectories: string[] = [];
+
+afterEach(async () => {
+  await Promise.all(
+    temporaryDirectories
+      .splice(0)
+      .map((directory) => rm(directory, { force: true, recursive: true })),
+  );
+});
+
+function canonical(
+  overrides: Partial<WhatsAppIngressCanonicalContext> = {},
+): WhatsAppIngressCanonicalContext {
+  return {
+    channelId: "whatsapp",
+    accountId: "personal",
+    conversationId: "chat-1",
+    senderId: "sender-1",
+    messageId: "message-1",
+    sessionKey: "agent:main:whatsapp:direct:chat-1",
+    content: " CONFIRMAR P-7 \n",
+    timestamp: 1_788_000_000_000,
+    isGroup: false,
+    ...overrides,
+  };
+}
+
+function directEnvelope(overrides: Partial<WhatsAppIngressEnvelope> = {}): WhatsAppIngressEnvelope {
+  const envelope = buildWhatsAppIngressEnvelope({
+    canonical: canonical(),
+    rawFacts: { modality: "text", origin: "direct", forwardingScore: 0 },
+    fromMe: false,
+  });
+  if (!envelope) {
+    throw new Error("fixture envelope was rejected");
+  }
+  return { ...envelope, ...overrides };
+}
+
+async function createSocketServer(
+  responder: (line: string) => string | undefined,
+): Promise<{ socketPath: string; close: () => Promise<void> }> {
+  const directory = await mkdtemp(path.join(os.tmpdir(), "openclaw-ingress-test-"));
+  temporaryDirectories.push(directory);
+  const socketPath = path.join(directory, "ingress.sock");
+  const server = net.createServer((socket) => {
+    let input = "";
+    socket.setEncoding("utf8");
+    socket.on("data", (chunk) => {
+      input += chunk;
+    });
+    socket.on("end", () => {
+      const response = responder(input);
+      if (response !== undefined) {
+        socket.end(response);
+      }
+    });
+  });
+  await new Promise<void>((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(socketPath, resolve);
+  });
+  return {
+    socketPath,
+    close: () => new Promise<void>((resolve) => server.close(() => resolve())),
+  };
+}
+
+describe("raw WhatsApp ingress facts", () => {
+  it("classifies recognized direct text and ignores forwarding metadata in the quote", () => {
+    const message = {
+      extendedTextMessage: {
+        text: "CONFIRMAR P-7",
+        contextInfo: {
+          quotedMessage: {
+            extendedTextMessage: {
+              text: "forwarded quote",
+              contextInfo: { isForwarded: true, forwardingScore: 8 },
+            },
+          },
+        },
+      },
+    } as proto.IMessage;
+
+    expect(captureWhatsAppIngressRawFacts(message)).toEqual({
+      modality: "text",
+      origin: "direct",
+      forwardingScore: 0,
+    });
+  });
+
+  it.each([
+    [{ extendedTextMessage: { text: "x", contextInfo: { isForwarded: true } } }, 0],
+    [{ extendedTextMessage: { text: "x", contextInfo: { forwardingScore: 3 } } }, 3],
+  ])("classifies explicit forwarding", (message, forwardingScore) => {
+    expect(captureWhatsAppIngressRawFacts(message as proto.IMessage)).toEqual({
+      modality: "text",
+      origin: "forwarded",
+      forwardingScore,
+    });
+  });
+
+  it("preserves audio modality through a supported wrapper", () => {
+    const message = {
+      ephemeralMessage: {
+        message: { audioMessage: { mimetype: "audio/ogg; codecs=opus" } },
+      },
+    } as proto.IMessage;
+    expect(captureWhatsAppIngressRawFacts(message)).toMatchObject({
+      modality: "audio",
+      origin: "direct",
+    });
+  });
+
+  it("fails closed on an unknown current-message form", () => {
+    const message = { protocolMessage: { type: 0 } } as proto.IMessage;
+    expect(captureWhatsAppIngressRawFacts(message)).toEqual({
+      modality: "unknown",
+      origin: "unknown",
+      forwardingScore: 0,
+    });
+  });
+
+  it.each([
+    {
+      label: "button response selectedButtonId",
+      message: { buttonsResponseMessage: { selectedButtonId: "CONFIRMAR NF-123" } },
+    },
+    {
+      label: "list response selectedRowId",
+      message: {
+        listResponseMessage: { singleSelectReply: { selectedRowId: "CONFIRMAR NF-123" } },
+      },
+    },
+    {
+      label: "template response selectedId",
+      message: { templateButtonReplyMessage: { selectedId: "CONFIRMAR NF-123" } },
+    },
+    {
+      label: "interactive native-flow params.id fallback",
+      message: {
+        interactiveResponseMessage: {
+          nativeFlowResponseMessage: { paramsJson: '{"id":"CONFIRMAR NF-123"}' },
+        },
+      },
+    },
+  ])("does not authorize $label as written text", ({ message }) => {
+    expect(captureWhatsAppIngressRawFacts(message as proto.IMessage)).toEqual({
+      modality: "unknown",
+      origin: "unknown",
+      forwardingScore: 0,
+    });
+  });
+
+  it("keeps facts non-enumerable and copies them only through the trusted helper", () => {
+    const source = attachWhatsAppIngressRawFacts(
+      { payload: "visible" },
+      { modality: "text", origin: "direct", forwardingScore: 0 },
+    );
+    expect(Object.keys(source)).toEqual(["payload"]);
+    expect(JSON.stringify(source)).toBe('{"payload":"visible"}');
+    expect(resolveWhatsAppIngressRawFacts({ ...source })).toBeUndefined();
+    const target = copyWhatsAppIngressRawFacts(source, { cloned: true });
+    expect(resolveWhatsAppIngressRawFacts(target)).toEqual({
+      modality: "text",
+      origin: "direct",
+      forwardingScore: 0,
+    });
+  });
+});
+
+describe("canonical envelope", () => {
+  it("uses exact canonical identity/content bytes and binary key ordering", () => {
+    const context = canonical({ replyToId: "short", replyToIdFull: "full" });
+    const envelope = buildWhatsAppIngressEnvelope({
+      canonical: context,
+      rawFacts: { modality: "text", origin: "direct", forwardingScore: 0 },
+      fromMe: false,
+    });
+    expect(envelope).not.toBeNull();
+    expect(envelope?.reply_to_id).toBe("full");
+    expect(envelope?.content_sha256).toBe(
+      createHash("sha256").update(context.content, "utf8").digest("hex"),
+    );
+    expect(envelope?.attestation_id).toBe(
+      whatsappIngressAttestationId("personal", "chat-1", "message-1"),
+    );
+    const canonicalJson = canonicalWhatsAppIngressEnvelope(envelope as WhatsAppIngressEnvelope);
+    expect(Object.keys(JSON.parse(canonicalJson))).toEqual(
+      Object.keys(JSON.parse(canonicalJson)).toSorted(),
+    );
+    const key = Buffer.from("12345678901234567890123456789012", "utf8");
+    expect(signWhatsAppIngressEnvelope(envelope as WhatsAppIngressEnvelope, key)).toBe(
+      `v1=${createHmac("sha256", key).update(canonicalJson, "utf8").digest("hex")}`,
+    );
+  });
+
+  it.each([
+    { accountId: undefined },
+    { content: undefined as unknown as string },
+    { timestamp: 1.5 },
+    { messageId: "bad\nmessage" },
+    { channelId: "telegram" },
+  ])("rejects invalid canonical context %#", (overrides) => {
+    expect(
+      buildWhatsAppIngressEnvelope({
+        canonical: canonical(overrides),
+        rawFacts: { modality: "text", origin: "direct", forwardingScore: 0 },
+        fromMe: false,
+      }),
+    ).toBeNull();
+  });
+});
+
+describe("private Unix delivery", () => {
+  it("accepts only the exact durable ACK", async () => {
+    const envelope = directEnvelope();
+    const server = await createSocketServer((line) => {
+      const wire = JSON.parse(line.trim()) as { envelope: WhatsAppIngressEnvelope };
+      return `ACK ${wire.envelope.attestation_id}\n`;
+    });
+    await expect(
+      deliverWhatsAppIngressAttestation({
+        socketPath: server.socketPath,
+        envelope,
+        signature: `v1=${"a".repeat(64)}`,
+      }),
+    ).resolves.toBe("acknowledged");
+    await server.close();
+  });
+
+  it("distinguishes explicit rejection or absence from uncertain delivery", async () => {
+    const envelope = directEnvelope();
+    const nack = await createSocketServer(() => "NACK INVALID\n");
+    await expect(
+      deliverWhatsAppIngressAttestation({
+        socketPath: nack.socketPath,
+        envelope,
+        signature: `v1=${"a".repeat(64)}`,
+      }),
+    ).resolves.toBe("rejected");
+    await nack.close();
+
+    await expect(
+      deliverWhatsAppIngressAttestation({
+        socketPath: "/tmp/openclaw-ingress-definitely-absent.sock",
+        envelope,
+        signature: `v1=${"a".repeat(64)}`,
+      }),
+    ).resolves.toBe("unavailable");
+
+    const badAck = await createSocketServer(() => "ACK wrong\n");
+    await expect(
+      deliverWhatsAppIngressAttestation({
+        socketPath: badAck.socketPath,
+        envelope: directEnvelope(),
+        signature: `v1=${"a".repeat(64)}`,
+      }),
+    ).resolves.toBe("uncertain");
+    await badAck.close();
+
+    const trailingAck = await createSocketServer(
+      () => `ACK ${directEnvelope().attestation_id}\ntrailing`,
+    );
+    await expect(
+      deliverWhatsAppIngressAttestation({
+        socketPath: trailingAck.socketPath,
+        envelope: directEnvelope(),
+        signature: `v1=${"a".repeat(64)}`,
+      }),
+    ).resolves.toBe("uncertain");
+    await trailingAck.close();
+
+    const timeout = await createSocketServer(() => undefined);
+    await expect(
+      deliverWhatsAppIngressAttestation({
+        socketPath: timeout.socketPath,
+        envelope: directEnvelope(),
+        signature: `v1=${"a".repeat(64)}`,
+        timeoutMs: 20,
+      }),
+    ).resolves.toBe("uncertain");
+    await timeout.close();
+
+    await expect(
+      deliverWhatsAppIngressAttestation({
+        socketPath: "/tmp/not-opened.sock",
+        envelope: directEnvelope({ sender_id: "x".repeat(9_000) }),
+        signature: `v1=${"a".repeat(64)}`,
+      }),
+    ).resolves.toBe("rejected");
+  });
+});
+
+describe("emitter gate", () => {
+  const key = "12345678901234567890123456789012";
+  const baseEnv = (socketPath: string): NodeJS.ProcessEnv => ({
+    NORTE_WHATSAPP_INGRESS_ATTESTATION_ENABLED: "true",
+    NORTE_WHATSAPP_INGRESS_ATTESTATION_SOCKET: socketPath,
+    NORTE_WHATSAPP_INGRESS_ATTESTATION_HMAC_KEY_ENV: "TEST_INGRESS_KEY",
+    NORTE_WHATSAPP_INGRESS_ATTESTATION_ALLOWED_ROUTES_JSON: JSON.stringify([
+      { accountId: "personal", conversationId: "chat-1", senderId: "sender-1" },
+    ]),
+    TEST_INGRESS_KEY: key,
+  });
+
+  it("is disabled by default and fails closed for invalid config/scope", async () => {
+    const message = attachWhatsAppIngressRawFacts(
+      {},
+      { modality: "text", origin: "direct", forwardingScore: 0 },
+    );
+    await expect(
+      attestWhatsAppInboundBeforeHooks({
+        message,
+        canonical: canonical(),
+        conversationKind: "direct",
+        fromMe: false,
+        env: {},
+      }),
+    ).resolves.toBe("disabled");
+    await expect(
+      attestWhatsAppInboundBeforeHooks({
+        message,
+        canonical: canonical(),
+        conversationKind: "direct",
+        fromMe: false,
+        env: { NORTE_WHATSAPP_INGRESS_ATTESTATION_ENABLED: "true" },
+      }),
+    ).resolves.toBe("configuration-invalid");
+    await expect(
+      attestWhatsAppInboundBeforeHooks({
+        message,
+        canonical: canonical({ senderId: "other" }),
+        conversationKind: "direct",
+        fromMe: false,
+        env: baseEnv("/tmp/not-opened.sock"),
+      }),
+    ).resolves.toBe("scope-denied");
+  });
+
+  it("signs and receives an ACK only for an allowed canonical route", async () => {
+    const server = await createSocketServer((line) => {
+      const wire = JSON.parse(line.trim()) as {
+        envelope: WhatsAppIngressEnvelope;
+        signature: string;
+      };
+      const expected = signWhatsAppIngressEnvelope(wire.envelope, Buffer.from(key, "utf8"));
+      expect(wire.signature).toBe(expected);
+      return `ACK ${wire.envelope.attestation_id}\n`;
+    });
+    const message = attachWhatsAppIngressRawFacts(
+      {},
+      { modality: "text", origin: "direct", forwardingScore: 0 },
+    );
+    await expect(
+      attestWhatsAppInboundBeforeHooks({
+        message,
+        canonical: canonical(),
+        conversationKind: "direct",
+        fromMe: false,
+        env: baseEnv(server.socketPath),
+      }),
+    ).resolves.toBe("delivered");
+    await server.close();
+  });
+});
