+++ b/extensions/whatsapp/src/inbound/ingress-attestation.ts
@@ -0,0 +1,579 @@
+import { createHash, createHmac } from "node:crypto";
+import net from "node:net";
+import path from "node:path";
+import { getContentType, normalizeMessageContent, type proto } from "baileys";
+
+const ENABLED_ENV = "NORTE_WHATSAPP_INGRESS_ATTESTATION_ENABLED";
+const SOCKET_ENV = "NORTE_WHATSAPP_INGRESS_ATTESTATION_SOCKET";
+const KEY_NAME_ENV = "NORTE_WHATSAPP_INGRESS_ATTESTATION_HMAC_KEY_ENV";
+const ROUTES_ENV = "NORTE_WHATSAPP_INGRESS_ATTESTATION_ALLOWED_ROUTES_JSON";
+const CONTENT_NORMALIZATION = "whatsapp.hookContext.content.utf8.v1";
+const SCHEMA_VERSION = "norte.whatsapp-ingress.v1";
+const DEFAULT_TIMEOUT_MS = 1_500;
+const MAX_LINE_BYTES = 8_192;
+const MAX_ACK_BYTES = 256;
+const ID_PATTERN = /^[^\x00-\x1f\x7f]{1,512}$/;
+const ENV_NAME_PATTERN = /^[A-Za-z_][A-Za-z0-9_]{0,127}$/;
+
+export type WhatsAppIngressModality =
+  | "text"
+  | "audio"
+  | "image"
+  | "video"
+  | "document"
+  | "sticker"
+  | "contact"
+  | "location"
+  | "unknown";
+
+export type WhatsAppIngressOrigin = "direct" | "forwarded" | "unknown";
+
+export type WhatsAppIngressRawFacts = Readonly<{
+  modality: WhatsAppIngressModality;
+  origin: WhatsAppIngressOrigin;
+  forwardingScore: number;
+}>;
+
+export type WhatsAppIngressCanonicalContext = Readonly<{
+  channelId: string;
+  /** Provider recipient; OpenClaw 2026.9.2 resolves WhatsApp inbound hook conversations from this. */
+  to?: string;
+  accountId?: string;
+  conversationId?: string;
+  senderId?: string;
+  messageId?: string;
+  sessionKey?: string;
+  content: string;
+  timestamp?: number;
+  isGroup: boolean;
+  replyToId?: string;
+  replyToIdFull?: string;
+}>;
+
+export type WhatsAppIngressEnvelope = Readonly<{
+  schema_version: typeof SCHEMA_VERSION;
+  attestation_id: string;
+  channel: "whatsapp";
+  account_id: string;
+  conversation_id: string;
+  sender_id: string;
+  message_id: string;
+  session_key: string;
+  occurred_at_ms: number;
+  from_me: boolean;
+  is_group: boolean;
+  modality: WhatsAppIngressModality;
+  origin: WhatsAppIngressOrigin;
+  forwarding_score: number;
+  reply_to_id: string | null;
+  content_sha256: string;
+  content_normalization: typeof CONTENT_NORMALIZATION;
+}>;
+
+type TrustedRoute = Readonly<{
+  accountId: string;
+  conversationId: string;
+  senderId: string;
+}>;
+
+type EmitterConfig = Readonly<{
+  socketPath: string;
+  key: Uint8Array;
+  allowedRoutes: readonly TrustedRoute[];
+  timeoutMs: number;
+}>;
+
+export type WhatsAppIngressAttestationResult =
+  | "disabled"
+  | "configuration-invalid"
+  | "raw-facts-unavailable"
+  | "canonical-context-invalid"
+  | "scope-denied"
+  | "delivered"
+  | "delivery-absent-or-rejected"
+  | "delivery-uncertain";
+
+export type WhatsAppIngressDeliveryResult =
+  | "acknowledged"
+  | "unavailable"
+  | "rejected"
+  | "uncertain";
+
+const rawFactsKey: unique symbol = Symbol("whatsappIngressRawFacts");
+
+type RawFactsCarrier = {
+  [rawFactsKey]?: WhatsAppIngressRawFacts;
+};
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
+}
+
+function getFutureProofInnerMessage(message: proto.IMessage): proto.IMessage | undefined {
+  const contentType = getContentType(message);
+  const candidate = contentType ? (message as Record<string, unknown>)[contentType] : undefined;
+  if (!isRecord(candidate) || !isRecord(candidate.message)) {
+    return undefined;
+  }
+  const inner = normalizeMessageContent(candidate.message as proto.IMessage);
+  if (!inner) {
+    return undefined;
+  }
+  const innerType = getContentType(inner);
+  return innerType && innerType !== contentType ? inner : undefined;
+}
+
+function projectCurrentMessage(
+  message: proto.IMessage | null | undefined,
+): readonly proto.IMessage[] {
+  const chain: proto.IMessage[] = [];
+  let current = normalizeMessageContent(message ?? undefined);
+  while (current && chain.length < 4) {
+    chain.push(current);
+    current = getFutureProofInnerMessage(current);
+  }
+  return chain;
+}
+
+function currentMessageContextInfo(
+  projection: readonly proto.IMessage[],
+): proto.IContextInfo | undefined {
+  for (const message of projection) {
+    const contentType = getContentType(message);
+    const candidate = contentType ? (message as Record<string, unknown>)[contentType] : undefined;
+    if (isRecord(candidate) && candidate.contextInfo) {
+      return candidate.contextInfo as proto.IContextInfo;
+    }
+    const fallback =
+      message.extendedTextMessage?.contextInfo ??
+      message.imageMessage?.contextInfo ??
+      message.videoMessage?.contextInfo ??
+      message.documentMessage?.contextInfo ??
+      message.audioMessage?.contextInfo ??
+      message.stickerMessage?.contextInfo ??
+      message.buttonsResponseMessage?.contextInfo ??
+      message.listResponseMessage?.contextInfo ??
+      message.templateButtonReplyMessage?.contextInfo ??
+      message.interactiveResponseMessage?.contextInfo;
+    if (fallback) {
+      return fallback;
+    }
+  }
+  return undefined;
+}
+
+function exactId(value: unknown): value is string {
+  return typeof value === "string" && ID_PATTERN.test(value);
+}
+
+function readForwardingScore(value: unknown): number | null {
+  if (value === undefined || value === null) {
+    return 0;
+  }
+  if (typeof value === "number") {
+    return Number.isSafeInteger(value) && value >= 0 ? value : null;
+  }
+  if (typeof value === "bigint") {
+    return value >= 0n && value <= BigInt(Number.MAX_SAFE_INTEGER) ? Number(value) : null;
+  }
+  if (typeof value === "string" && /^(0|[1-9][0-9]*)$/.test(value)) {
+    const parsed = Number(value);
+    return Number.isSafeInteger(parsed) ? parsed : null;
+  }
+  if (isRecord(value) && typeof value.toString === "function") {
+    const rendered = value.toString();
+    if (/^(0|[1-9][0-9]*)$/.test(rendered)) {
+      const parsed = Number(rendered);
+      return Number.isSafeInteger(parsed) ? parsed : null;
+    }
+  }
+  return null;
+}
+
+function modalityFromProjection(projection: readonly proto.IMessage[]): WhatsAppIngressModality {
+  for (const message of projection.toReversed()) {
+    if (message.audioMessage) {
+      return "audio";
+    }
+    if (message.imageMessage) {
+      return "image";
+    }
+    if (message.videoMessage || message.ptvMessage) {
+      return "video";
+    }
+    if (message.documentMessage) {
+      return "document";
+    }
+    if (message.stickerMessage) {
+      return "sticker";
+    }
+    if (message.contactMessage || message.contactsArrayMessage) {
+      return "contact";
+    }
+    if (message.locationMessage || message.liveLocationMessage) {
+      return "location";
+    }
+    if (
+      typeof message.conversation === "string" ||
+      typeof message.extendedTextMessage?.text === "string"
+    ) {
+      return "text";
+    }
+  }
+  return "unknown";
+}
+
+/** Captures facts from the current provider message only; quotedMessage is never traversed. */
+export function captureWhatsAppIngressRawFacts(
+  message: proto.IMessage | null | undefined,
+): WhatsAppIngressRawFacts {
+  const projection = projectCurrentMessage(message);
+  const modality = modalityFromProjection(projection);
+  const contextInfo = currentMessageContextInfo(projection);
+  const forwardingScore = readForwardingScore(contextInfo?.forwardingScore);
+  const forwardingFlag = contextInfo?.isForwarded;
+  const malformedFlag =
+    forwardingFlag !== undefined && forwardingFlag !== null && typeof forwardingFlag !== "boolean";
+  const origin: WhatsAppIngressOrigin =
+    forwardingFlag === true || (forwardingScore !== null && forwardingScore > 0)
+      ? "forwarded"
+      : projection.length === 0 ||
+          modality === "unknown" ||
+          forwardingScore === null ||
+          malformedFlag
+        ? "unknown"
+        : "direct";
+  return Object.freeze({
+    modality,
+    origin,
+    forwardingScore: forwardingScore ?? 0,
+  });
+}
+
+export function attachWhatsAppIngressRawFacts<T extends object>(
+  target: T,
+  facts: WhatsAppIngressRawFacts,
+): T {
+  Object.defineProperty(target, rawFactsKey, {
+    configurable: false,
+    enumerable: false,
+    writable: false,
+    value: facts,
+  });
+  return target;
+}
+
+export function copyWhatsAppIngressRawFacts<T extends object>(source: object, target: T): T {
+  const facts = resolveWhatsAppIngressRawFacts(source);
+  return facts ? attachWhatsAppIngressRawFacts(target, facts) : target;
+}
+
+export function resolveWhatsAppIngressRawFacts(
+  source: object,
+): WhatsAppIngressRawFacts | undefined {
+  return (source as RawFactsCarrier)[rawFactsKey];
+}
+
+function parseAllowedRoutes(raw: string | undefined): readonly TrustedRoute[] | null {
+  if (!raw) {
+    return null;
+  }
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    if (!Array.isArray(parsed) || parsed.length === 0 || parsed.length > 1_000) {
+      return null;
+    }
+    const routes: TrustedRoute[] = [];
+    for (const entry of parsed) {
+      if (!isRecord(entry)) {
+        return null;
+      }
+      const keys = Object.keys(entry).toSorted();
+      if (
+        keys.length !== 3 ||
+        keys[0] !== "accountId" ||
+        keys[1] !== "conversationId" ||
+        keys[2] !== "senderId" ||
+        !exactId(entry.accountId) ||
+        !exactId(entry.conversationId) ||
+        !exactId(entry.senderId)
+      ) {
+        return null;
+      }
+      routes.push(
+        Object.freeze({
+          accountId: entry.accountId,
+          conversationId: entry.conversationId,
+          senderId: entry.senderId,
+        }),
+      );
+    }
+    return Object.freeze(routes);
+  } catch {
+    return null;
+  }
+}
+
+function resolveEmitterConfig(env: NodeJS.ProcessEnv): EmitterConfig | "disabled" | null {
+  if (env[ENABLED_ENV] !== "true") {
+    return "disabled";
+  }
+  const socketPath = env[SOCKET_ENV];
+  const keyEnvName = env[KEY_NAME_ENV];
+  const routes = parseAllowedRoutes(env[ROUTES_ENV]);
+  if (
+    !socketPath ||
+    !path.isAbsolute(socketPath) ||
+    Buffer.byteLength(socketPath, "utf8") > 100 ||
+    socketPath.includes("\0") ||
+    !keyEnvName ||
+    !ENV_NAME_PATTERN.test(keyEnvName) ||
+    !routes
+  ) {
+    return null;
+  }
+  const keyValue = env[keyEnvName];
+  if (typeof keyValue !== "string") {
+    return null;
+  }
+  const key = Buffer.from(keyValue, "utf8");
+  if (key.byteLength < 32 || key.byteLength > 4_096) {
+    return null;
+  }
+  return Object.freeze({ socketPath, key, allowedRoutes: routes, timeoutMs: DEFAULT_TIMEOUT_MS });
+}
+
+function routeAllowed(config: EmitterConfig, canonical: WhatsAppIngressCanonicalContext): boolean {
+  return config.allowedRoutes.some(
+    (route) =>
+      route.accountId === canonical.accountId &&
+      route.conversationId === canonical.conversationId &&
+      route.senderId === canonical.senderId,
+  );
+}
+
+function sha256(value: string): string {
+  return createHash("sha256").update(value, "utf8").digest("hex");
+}
+
+export function whatsappIngressAttestationId(
+  accountId: string,
+  conversationId: string,
+  messageId: string,
+): string {
+  return sha256(`${accountId}\0${conversationId}\0${messageId}`);
+}
+
+export function buildWhatsAppIngressEnvelope(params: {
+  canonical: WhatsAppIngressCanonicalContext;
+  rawFacts: WhatsAppIngressRawFacts;
+  fromMe: boolean;
+}): WhatsAppIngressEnvelope | null {
+  const { canonical, rawFacts } = params;
+  const occurredAtMs = canonical.timestamp;
+  if (
+    canonical.channelId !== "whatsapp" ||
+    !exactId(canonical.accountId) ||
+    !exactId(canonical.conversationId) ||
+    !exactId(canonical.senderId) ||
+    !exactId(canonical.messageId) ||
+    !exactId(canonical.sessionKey) ||
+    typeof canonical.content !== "string" ||
+    typeof occurredAtMs !== "number" ||
+    !Number.isSafeInteger(occurredAtMs) ||
+    occurredAtMs < 0 ||
+    typeof canonical.isGroup !== "boolean" ||
+    typeof params.fromMe !== "boolean"
+  ) {
+    return null;
+  }
+  const replyToId = canonical.replyToIdFull ?? canonical.replyToId ?? null;
+  if (replyToId !== null && !exactId(replyToId)) {
+    return null;
+  }
+  if (
+    !Number.isSafeInteger(rawFacts.forwardingScore) ||
+    rawFacts.forwardingScore < 0 ||
+    ![
+      "text",
+      "audio",
+      "image",
+      "video",
+      "document",
+      "sticker",
+      "contact",
+      "location",
+      "unknown",
+    ].includes(rawFacts.modality) ||
+    !["direct", "forwarded", "unknown"].includes(rawFacts.origin)
+  ) {
+    return null;
+  }
+  return Object.freeze({
+    schema_version: SCHEMA_VERSION,
+    attestation_id: whatsappIngressAttestationId(
+      canonical.accountId,
+      canonical.conversationId,
+      canonical.messageId,
+    ),
+    channel: "whatsapp",
+    account_id: canonical.accountId,
+    conversation_id: canonical.conversationId,
+    sender_id: canonical.senderId,
+    message_id: canonical.messageId,
+    session_key: canonical.sessionKey,
+    occurred_at_ms: occurredAtMs,
+    from_me: params.fromMe,
+    is_group: canonical.isGroup,
+    modality: rawFacts.modality,
+    origin: rawFacts.origin,
+    forwarding_score: rawFacts.forwardingScore,
+    reply_to_id: replyToId,
+    content_sha256: sha256(canonical.content),
+    content_normalization: CONTENT_NORMALIZATION,
+  });
+}
+
+/** Binary/code-unit key ordering; never localeCompare or value normalization. */
+export function canonicalWhatsAppIngressEnvelope(envelope: WhatsAppIngressEnvelope): string {
+  return `{${Object.entries(envelope)
+    .sort(([left], [right]) => (left < right ? -1 : left > right ? 1 : 0))
+    .map(([key, value]) => `${JSON.stringify(key)}:${JSON.stringify(value)}`)
+    .join(",")}}`;
+}
+
+export function signWhatsAppIngressEnvelope(
+  envelope: WhatsAppIngressEnvelope,
+  key: Uint8Array,
+): string {
+  if (key.byteLength < 32 || key.byteLength > 4_096) {
+    throw new Error("invalid ingress attestation key");
+  }
+  return `v1=${createHmac("sha256", key)
+    .update(canonicalWhatsAppIngressEnvelope(envelope), "utf8")
+    .digest("hex")}`;
+}
+
+export async function deliverWhatsAppIngressAttestation(params: {
+  socketPath: string;
+  envelope: WhatsAppIngressEnvelope;
+  signature: string;
+  timeoutMs?: number;
+}): Promise<WhatsAppIngressDeliveryResult> {
+  const timeoutMs = params.timeoutMs ?? DEFAULT_TIMEOUT_MS;
+  if (!Number.isSafeInteger(timeoutMs) || timeoutMs < 1 || timeoutMs > 5_000) {
+    return "rejected";
+  }
+  const frame = `${JSON.stringify({ envelope: params.envelope, signature: params.signature })}\n`;
+  if (Buffer.byteLength(frame, "utf8") > MAX_LINE_BYTES) {
+    return "rejected";
+  }
+  const expectedAck = `ACK ${params.envelope.attestation_id}\n`;
+  const expectedNack = "NACK INVALID\n";
+  return await new Promise<WhatsAppIngressDeliveryResult>((resolve) => {
+    let settled = false;
+    let connected = false;
+    let response = Buffer.alloc(0);
+    let socket: net.Socket | undefined;
+    const finish = (result: WhatsAppIngressDeliveryResult) => {
+      if (settled) {
+        return;
+      }
+      settled = true;
+      clearTimeout(deadline);
+      socket?.destroy();
+      resolve(result);
+    };
+    const classifyCompleteResponse = (): WhatsAppIngressDeliveryResult => {
+      const rendered = response.toString("utf8");
+      if (rendered === expectedAck) {
+        return "acknowledged";
+      }
+      if (rendered === expectedNack) {
+        return "rejected";
+      }
+      return connected ? "uncertain" : "unavailable";
+    };
+    const deadline = setTimeout(() => finish(connected ? "uncertain" : "unavailable"), timeoutMs);
+    deadline.unref?.();
+    try {
+      socket = net.createConnection({ path: params.socketPath });
+    } catch {
+      clearTimeout(deadline);
+      resolve("unavailable");
+      return;
+    }
+    socket.once("connect", () => {
+      connected = true;
+      socket?.end(frame);
+    });
+    socket.once("error", () => finish(connected ? "uncertain" : "unavailable"));
+    socket.on("data", (chunk: Buffer) => {
+      response = Buffer.concat([response, chunk]);
+      if (
+        response.byteLength > MAX_ACK_BYTES ||
+        (response.byteLength > Buffer.byteLength(expectedAck, "utf8") &&
+          response.byteLength > Buffer.byteLength(expectedNack, "utf8"))
+      ) {
+        finish("uncertain");
+      }
+    });
+    socket.once("end", () => finish(classifyCompleteResponse()));
+    socket.once("close", () => finish(classifyCompleteResponse()));
+  });
+}
+
+/**
+ * Best-effort availability, fail-closed authorization: normal chat continues on failure. A
+ * missing ACK is not proof of a missing commit; only Norte's durable HMAC-bound proof is
+ * authoritative, and an uncertain outcome must not ask the human to authorize the action again.
+ */
+export async function attestWhatsAppInboundBeforeHooks(params: {
+  message: object;
+  canonical: WhatsAppIngressCanonicalContext;
+  conversationKind: "direct" | "group";
+  fromMe: boolean;
+  env?: NodeJS.ProcessEnv;
+}): Promise<WhatsAppIngressAttestationResult> {
+  const config = resolveEmitterConfig(params.env ?? process.env);
+  if (config === "disabled") {
+    return "disabled";
+  }
+  if (!config) {
+    return "configuration-invalid";
+  }
+  const rawFacts = resolveWhatsAppIngressRawFacts(params.message);
+  if (!rawFacts) {
+    return "raw-facts-unavailable";
+  }
+  // Match the exact conversation identity projected by toPluginInboundClaimPair and later passed
+  // to before_dispatch. In OpenClaw 2026.9.2 WhatsApp has no channel-specific resolver, so the
+  // generic resolver selects `to` before the earlier canonical conversation fallback.
+  const canonical = {
+    ...params.canonical,
+    conversationId: params.canonical.to ?? params.canonical.conversationId,
+    isGroup: params.conversationKind === "group",
+  };
+  if (!routeAllowed(config, canonical)) {
+    return "scope-denied";
+  }
+  const envelope = buildWhatsAppIngressEnvelope({
+    canonical,
+    rawFacts,
+    fromMe: params.fromMe,
+  });
+  if (!envelope) {
+    return "canonical-context-invalid";
+  }
+  const signature = signWhatsAppIngressEnvelope(envelope, config.key);
+  const delivery = await deliverWhatsAppIngressAttestation({
+    socketPath: config.socketPath,
+    envelope,
+    signature,
+    timeoutMs: config.timeoutMs,
+  });
+  if (delivery === "acknowledged") {
+    return "delivered";
+  }
+  return delivery === "uncertain" ? "delivery-uncertain" : "delivery-absent-or-rejected";
+}
